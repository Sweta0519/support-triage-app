# The support-triage Supabase project (this app's tables live under the
# `ticketing` schema, not `public`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Dashboard -> Project Settings -> API -> service_role.
# Server-side only. Never NEXT_PUBLIC_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Used for the AI triage agent's chat + embedding calls.
OPENROUTER_API_KEY=

# Used to build auth redirect/confirmation links. Never derive this from the
# request's Origin/Host headers -- those are attacker-controllable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on /privacy as the address for access, export and deletion requests.
# Server-only (no NEXT_PUBLIC_ prefix); the page falls back to generic wording if unset.
PRIVACY_CONTACT_EMAIL=

# Email intake (SUP-80, docs/email.md). Server-only, never NEXT_PUBLIC_-prefixed.
# Resend dashboard -> API Keys (used to fetch received emails and send replies).
RESEND_API_KEY=
# Resend dashboard -> Webhooks -> the email.received webhook's signing secret (whsec_...).
RESEND_WEBHOOK_SECRET=
# The receiving domain: the account's <id>.resend.app until a domain is set up.
EMAIL_INBOUND_DOMAIN=

# Signed outbound webhook to n8n (SUP-94). Server-only, never NEXT_PUBLIC_-prefixed.
# Leave either unset to turn the webhook off.
# N8N_WEBHOOK_SECRET must equal the Hmac Secret of the n8n Crypto credential (docs/n8n/README.md).
# In production N8N_WEBHOOK_URL is the hosted n8n's https webhook URL.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# The one workspace id whose alerts are sent. Unset = nothing is sent or recorded.
N8N_WEBHOOK_WORKSPACE_ID=
