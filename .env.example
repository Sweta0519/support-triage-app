# Same Supabase project as notes-collections (shared auth.users; this app's
# tables live under the `ticketing` schema, not `public`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Dashboard -> Project Settings -> API -> service_role.
# Server-side only. Never NEXT_PUBLIC_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only. Used for the AI triage agent's chat + embedding calls.
OPENROUTER_API_KEY=

# Used to build auth redirect/confirmation links. Never derive this from the
# request's Origin/Host headers -- those are attacker-controllable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on /privacy as the address for access, export and deletion requests.
# Server-only (no NEXT_PUBLIC_ prefix); the page falls back to generic wording if unset.
PRIVACY_CONTACT_EMAIL=
