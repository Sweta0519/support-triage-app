        "dataPropertyName": "expected_signature",
        "secret": "={{ $env.N8N_WEBHOOK_SECRET }}",
        "encoding": "hex"
      },
      "id": "8f0b3c1e-0002-4a00-9000-000000000002",
      "name": "Compute HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        240,
