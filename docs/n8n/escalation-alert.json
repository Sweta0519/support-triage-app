{
  "name": "Support triage: escalation and incident alerts (SUP-95, SUP-96)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "escalation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "8f0b3c1e-0001-4a00-9000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "5d1f6a52-95e4-4c1b-9a43-0e5ca1a7e001"
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.headers['x-timestamp'] }}.{{ JSON.stringify($json.body) }}",
        "dataPropertyName": "expected_signature",
        "secret": "={{ $env.N8N_WEBHOOK_SECRET }}",
        "encoding": "hex"
      },
      "id": "8f0b3c1e-0002-4a00-9000-000000000002",
      "name": "Compute HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ !!$env.N8N_WEBHOOK_SECRET }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c1",
              "leftValue": "={{ $json.headers['x-signature'] }}",
              "rightValue": "=sha256={{ $json.expected_signature }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ Math.abs(Date.now() / 1000 - Number($json.headers['x-timestamp'])) < 300 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8f0b3c1e-0003-4a00-9000-000000000003",
      "name": "Signed and fresh?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#support-alerts",
          "mode": "name"
        },
        "text": "=:rotating_light: *Escalation risk* - {{ $json.body.data.priority }} priority, {{ $json.body.data.team }} team, {{ $json.body.data.category }}\n*Summary:* {{ $json.body.data.summary.replace(/\\s+/g, ' ').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;') }}\n<{{ $json.body.data.link }}|View ticket>",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "8f0b3c1e-0004-4a00-9000-000000000004",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "8f0b3c1e-0005-4a00-9000-000000000005",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"invalid signature\" }",
        "options": {
          "responseCode": 401
        }
      },
      "id": "8f0b3c1e-0006-4a00-9000-000000000006",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        640
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "escalation",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "r-escalation",
                    "leftValue": "={{ $json.body.type }}",
                    "rightValue": "ticket.escalation_flagged",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "incident",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "r-incident",
                    "leftValue": "={{ $json.body.type }}",
                    "rightValue": "incident.opened",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Unsupported"
        }
      },
      "id": "8f0b3c1e-0007-4a00-9000-000000000007",
      "name": "Route by event type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.5,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#support-alerts",
          "mode": "name"
        },
        "text": "=:warning: *Possible incident* - {{ $json.body.data.ticket_count }} tickets\n*Title:* {{ $json.body.data.title.replace(/\\s+/g, ' ').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;') }}\n*Summary:* {{ ($json.body.data.summary ?? 'No AI summary available. See the incident page.').replace(/\\s+/g, ' ').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;') }}\n<{{ $json.body.data.link }}|View incident>",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "8f0b3c1e-0008-4a00-9000-000000000008",
      "name": "Post incident to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"unsupported event type\" }",
        "options": {
          "responseCode": 422
        }
      },
      "id": "8f0b3c1e-0009-4a00-9000-000000000009",
      "name": "Respond 422",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        500
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Compute HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compute HMAC": {
      "main": [
        [
          {
            "node": "Signed and fresh?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Signed and fresh?": {
      "main": [
        [
          {
            "node": "Route by event type",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 401",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to Slack": {
      "main": [
        [
          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by event type": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Post incident to Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 422",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post incident to Slack": {
      "main": [
        [
          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}